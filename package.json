{
  "name": "system-one-deslop",
  "version": "0.0.0",
  "private": true,
  "description": "Pre-alpha scaffolding for prose judgments with TypeSafe System One.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "./scripts/quiet-run.sh \"typecheck\" tsc --noEmit",
    "test": "npm run build --silent && ./scripts/quiet-run.sh \"tests\" node --test dist/test/*.test.js",
    "build": "./scripts/quiet-run.sh \"build\" tsc",
    "lint": "./scripts/quiet-run.sh \"lint\" oxlint",
    "format": "./scripts/quiet-run.sh \"format\" oxfmt --write .",
    "format:check": "./scripts/quiet-run.sh \"format check\" oxfmt --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "smoke": "npm run build --silent && node --env-file=.env dist/scripts/smoke.js",
    "eval": "npm run build --silent && node --env-file=.env dist/scripts/eval.js",
    "audit": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/audit.js",
    "corpus-report": "npm run build --silent && node dist/scripts/corpus-report.js",
    "deslop": "npm run build --silent && node --env-file=.env dist/scripts/deslop.js",
    "brief-experiment": "npm run build --silent && node --env-file=.env dist/scripts/brief-experiment.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
